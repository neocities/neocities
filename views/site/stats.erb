<div class="header-Outro stats-page-header">
  <div class="content">
    <p class="stats-page-eyebrow"><i class="fa fa-line-chart" aria-hidden="true"></i> Site statistics</p>
    <h1>Traffic for <%= site.host %></h1>
  </div>
</div>

<div class="container stats-page">
  <div class="content misc-page stats-page-layout">
    <main class="stats-dashboard">
      <section class="stats-overview" aria-labelledby="traffic-overview-heading">
        <div class="stats-toolbar">
          <div>
            <p class="stats-section-eyebrow">Traffic overview</p>
            <h2 id="traffic-overview-heading"><%= @stat_range_label %></h2>
          </div>

          <% if @can_view_site_stats %>
            <a class="stats-download" href="?days=<%= @selected_stat_range %>&amp;format=csv">
              <i class="fa fa-download" aria-hidden="true"></i> Download CSV
            </a>
          <% end %>
        </div>

        <% if @can_view_site_stats && site.supporter? %>
          <nav class="stats-range" aria-label="Statistics date range">
            <% @stat_range_options.each do |range, label| %>
              <a href="?days=<%= range %>"<% if @selected_stat_range.to_s == range.to_s %> class="selected" aria-current="page"<% end %>><%= label %></a>
            <% end %>
          </nav>
        <% elsif @can_view_site_stats %>
          <div class="stats-retention-note">
            <i class="fa fa-clock-o" aria-hidden="true"></i>
            <p>
              Free sites keep up to <%= Stat::FREE_RETAINMENT_DAYS %> days of traffic history.
              <a href="/supporter">Become a supporter</a> to unlock longer date ranges and keep your history.
            </p>
          </div>
        <% end %>

        <div class="stats-metrics" aria-label="Traffic totals">
          <article class="stats-metric stats-metric-visits">
            <span class="stats-metric-icon"><i class="fa fa-user" aria-hidden="true"></i></span>
            <div>
              <p>Total visits</p>
              <strong class="stats-metric-value"><%= @stat_summary[:views].to_comma_separated %></strong>
              <span>during this period</span>
            </div>
          </article>

          <article class="stats-metric stats-metric-hits">
            <span class="stats-metric-icon"><i class="fa fa-server" aria-hidden="true"></i></span>
            <div>
              <p>Total hits</p>
              <strong class="stats-metric-value"><%= @stat_summary[:hits].to_comma_separated %></strong>
              <span>files sent to visitors</span>
            </div>
          </article>

          <article class="stats-metric stats-metric-average">
            <span class="stats-metric-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
            <div>
              <p>Average visits</p>
              <strong class="stats-metric-value"><%= @stat_summary[:average_views].to_comma_separated %></strong>
              <span>per day</span>
            </div>
          </article>
        </div>
      </section>

      <section class="stats-panel stats-chart-panel" aria-labelledby="daily-traffic-heading">
        <div class="stats-panel-heading">
          <div>
            <h2 id="daily-traffic-heading">Daily traffic</h2>
            <p id="stats-chart-description">Compare visits with the number of files your site served each day.</p>
          </div>
          <% unless @stats[:stat_days].empty? %>
            <span><%= @stat_summary[:days] %> day<%= @stat_summary[:days] == 1 ? '' : 's' %></span>
          <% end %>
        </div>

        <% if @stats[:stat_days].empty? %>
          <div class="stats-empty">
            <i class="fa fa-bar-chart" aria-hidden="true"></i>
            <h3>No traffic to chart yet</h3>
            <p>There are no completed days with traffic in this period. Check back after people visit the site.</p>
          </div>
        <% else %>
          <div class="stats-chart-legend" role="list" aria-label="Chart legend">
            <span role="listitem"><i class="stats-chart-legend-dot stats-chart-legend-dot-visits" aria-hidden="true"></i>Visits</span>
            <span role="listitem"><i class="stats-chart-legend-dot stats-chart-legend-dot-hits" aria-hidden="true"></i>Hits</span>
          </div>
          <div class="stats-chart">
            <canvas id="traffic-chart" role="img" aria-label="Line chart of daily visits and hits" aria-describedby="stats-chart-description"></canvas>
          </div>
        <% end %>
      </section>

      <section class="stats-panel stats-guide" aria-labelledby="reading-stats-heading">
        <div class="stats-panel-heading">
          <div>
            <h2 id="reading-stats-heading">Reading your stats</h2>
            <p>These numbers are best for spotting patterns, not counting exact people.</p>
          </div>
        </div>

        <div class="stats-definitions">
          <article>
            <span class="stats-definition-icon stats-definition-icon-visits"><i class="fa fa-user" aria-hidden="true"></i></span>
            <div>
              <h3>What counts as a visit?</h3>
              <p>A visit is one unique IP address requesting pages within an hour. The same person can count again later or when using another network.</p>
            </div>
          </article>

          <article>
            <span class="stats-definition-icon stats-definition-icon-hits"><i class="fa fa-server" aria-hidden="true"></i></span>
            <div>
              <h3>What counts as a hit?</h3>
              <p>A hit is any file sent by the site&mdash;HTML, images, stylesheets, scripts, and more. One page view usually creates several hits.</p>
            </div>
          </article>
        </div>

        <p class="stats-caveat"><i class="fa fa-info-circle" aria-hidden="true"></i> Bots, search crawlers, shared networks, and privacy tools can all affect these totals.</p>
      </section>
    </main>

    <aside class="stats-site-summary" aria-labelledby="stats-site-name">
      <a class="stats-site-preview" href="<%= site.uri %>" target="_blank" rel="noopener" aria-label="Visit <%= site.title %>" style="background-image:url(<%= site.screenshot_url('index.html', '540x405') %>);"></a>

      <div class="stats-site-summary-body">
        <p class="stats-section-eyebrow">About this site</p>
        <h2 id="stats-site-name"><a href="<%= site.uri %>" target="_blank" rel="noopener"><%= site.title %></a></h2>
        <p class="stats-site-host"><%= site.host %></p>

        <dl class="stats-site-facts">
          <div>
            <dt>Last updated</dt>
            <% if site.site_updated_at %>
              <dd class="local-date-title" data-timestamp="<%= site.site_updated_at.to_i %>"><%= site.site_updated_at.ago %></dd>
            <% else %>
              <dd>Not published yet</dd>
            <% end %>
          </div>
          <div>
            <dt>All-time views</dt>
            <dd><%= site.views.to_comma_separated %></dd>
          </div>
          <div>
            <dt>Followers</dt>
            <dd><%= @follow_count.to_comma_separated %></dd>
          </div>
        </dl>

        <div class="stats-site-actions">
          <a href="<%= site.uri %>" class="btn-Action" target="_blank" rel="noopener"><i class="fa fa-external-link" aria-hidden="true"></i> Visit site</a>
          <a href="/site/<%= site.username %>" class="stats-profile-link"><i class="fa fa-user" aria-hidden="true"></i> View profile</a>
        </div>
      </div>
    </aside>
  </div>
</div>

<% unless @stats[:stat_days].empty? %>
  <script src="/js/chart.js"></script>
  <script>
    $(document).ready(function() {
      const chartData = {
        labels: <%== @stats[:stat_days].collect {|stat| stat.created_at.strftime('%b %-d, %Y')}.to_json %>,
        datasets: [
          {
            label: 'Visits',
            backgroundColor: 'rgba(233, 50, 80, 0.12)',
            borderColor: '#e93250',
            pointBackgroundColor: '#e93250',
            pointBorderColor: '#fff',
            pointHoverBackgroundColor: '#fff',
            pointHoverBorderColor: '#e93250',
            borderWidth: 2,
            pointRadius: 3,
            pointHoverRadius: 5,
            tension: 0.25,
            fill: true,
            data: <%== @stats[:stat_days].collect {|stat| stat.views}.to_json %>
          },
          {
            label: 'Hits',
            backgroundColor: 'rgba(94, 149, 161, 0.1)',
            borderColor: '#5e95a1',
            pointBackgroundColor: '#5e95a1',
            pointBorderColor: '#fff',
            pointHoverBackgroundColor: '#fff',
            pointHoverBorderColor: '#5e95a1',
            borderWidth: 2,
            pointRadius: 3,
            pointHoverRadius: 5,
            tension: 0.25,
            fill: true,
            data: <%== @stats[:stat_days].collect {|stat| stat.hits}.to_json %>
          }
        ]
      };

      const chartContext = document.getElementById('traffic-chart').getContext('2d');
      const chartColors = function() {
        const isDark = document.documentElement.classList.contains('dark-Mode');
        return {
          text: isDark ? '#dbe7e7' : '#5c5a55',
          grid: isDark ? 'rgba(219, 231, 231, 0.12)' : 'rgba(48, 66, 75, 0.1)'
        };
      };
      const colors = chartColors();
      const trafficChart = new Chart(chartContext, {
        type: 'line',
        data: chartData,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          scales: {
            x: {
              grid: {
                display: false
              },
              ticks: {
                color: colors.text,
                maxRotation: 0,
                autoSkipPadding: 16
              }
            },
            y: {
              beginAtZero: true,
              grid: {
                color: colors.grid
              },
              ticks: {
                color: colors.text,
                precision: 0
              }
            }
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              padding: 12,
              bodyFont: {
                size: 14
              },
              titleFont: {
                size: 14
              }
            }
          }
        }
      });

      const updateChartTheme = function() {
        const updatedColors = chartColors();
        trafficChart.options.scales.x.ticks.color = updatedColors.text;
        trafficChart.options.scales.y.ticks.color = updatedColors.text;
        trafficChart.options.scales.y.grid.color = updatedColors.grid;
        trafficChart.update();
      };

      new MutationObserver(updateChartTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class']
      });
    });
  </script>
<% end %>
