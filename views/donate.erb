<div class="header-Outro donate-Hero">
  <div class="content donate-HeroInner">
    <div class="donate-HeroCopy">
      <span class="donate-Eyebrow">Community-funded since 2013</span>
      <h1>Help keep the web creative and independent.</h1>
      <p class="donate-HeroLead">
        Neocities gives everyone a place to build a website that feels like their own. Your donation helps us keep that place fast, reliable, and free of ads.
      </p>
    </div>

    <figure class="donate-HeroArt">
      <img src="/img/heartcat.svg" alt="The Neocities cat holding a heart">
    </figure>
  </div>
</div>

<main class="donate-Page">
  <div class="content">
    <div class="donate-Layout">
      <section class="donate-Card donate-Card--primary" aria-labelledby="donate-once-heading">
        <span class="donate-Kicker">One-time donation</span>
        <h2 id="donate-once-heading">Give what feels right.</h2>
        <p class="donate-CardLead">
          Any contribution, of any size, helps us care for Neocities today and build what comes next.
        </p>
        <a class="btn-Action donate-Button" href="https://donorbox.org/neocities">
          Donate now
          <i class="fa fa-arrow-right" aria-hidden="true"></i>
        </a>
        <p class="donate-Checkout">
          <i class="fa fa-lock" aria-hidden="true"></i>
          Checkout provided by Donorbox.
        </p>
      </section>

      <section class="donate-Impact" aria-labelledby="donate-impact-heading">
        <span class="donate-Kicker">Where your support goes</span>
        <h2 id="donate-impact-heading">The everyday work behind Neocities.</h2>

        <ul class="donate-ImpactList">
          <li>
            <span class="donate-ImpactIcon"><i class="fa fa-server" aria-hidden="true"></i></span>
            <div>
              <h3>Reliable infrastructure</h3>
              <p>Servers, storage, and bandwidth that keep sites available around the world.</p>
            </div>
          </li>
          <li>
            <span class="donate-ImpactIcon"><i class="fa fa-paint-brush" aria-hidden="true"></i></span>
            <div>
              <h3>A free place to create</h3>
              <p>A generous free plan that gives more people room to express themselves.</p>
            </div>
          </li>
          <li>
            <span class="donate-ImpactIcon"><i class="fa fa-code" aria-hidden="true"></i></span>
            <div>
              <h3>Independent development</h3>
              <p>Time to maintain, improve, and thoughtfully grow Neocities without advertising.</p>
            </div>
          </li>
        </ul>
      </section>
    </div>

    <section class="donate-Next" aria-labelledby="donate-monthly-heading">
      <div class="donate-NextCopy">
        <span class="donate-Kicker">Prefer monthly support?</span>
        <h2 id="donate-monthly-heading">Become a Neocities Supporter.</h2>
        <p>
          For $5 a month, you can fund the same mission and get more storage, custom domains, and extra features for your site.
        </p>
        <a class="donate-TextLink" href="/supporter">
          Explore the Supporter plan<i class="fa fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <p class="donate-Thanks">However you choose to help, thank you for believing in a web made by people.</p>
  </div>
</main>
