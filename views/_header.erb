<%
  header_account_sites = current_site ? current_site.account_sites_dataset.
    select(:id, :username, :domain, :parent_site_id).all : []
%>

<header class="header-Base">

  <nav class="header-Nav clearfix" role="navigation">

    <a href="#!" title="show small screen nav" class="small-Nav">
      <img src="/img/nav-Icon.png" alt="navigation icon" />
    </a>

    <ul class="h-Nav constant-Nav">
      <%== erb :'_header_links', layout: false %>
    </ul>

    <ul class="status-Nav">
      <% if !signed_in? %>
        <li>
          <a href="/#new" class="create-New">Sign up for Free</a>
        </li>
        <li>
          <a href="/signin" class="sign-In">Sign In</a>
        </li>
      <% else %>
        <li class="dropdown">
          <a href="#" data-toggle="dropdown" class="dropdown-toggle">
            <%= current_site.username %>
            <span class="info">
              <% if current_site.unseen_notifications_count > 0 %>
                <span class="notification-value"><%= current_site.unseen_notifications_count %></span>
              <% end %>
              <i class="fa fa-caret-down"></i>
            </span>
          </a>
          <ul class="dropdown-menu">
            <% if current_site && !current_site.tutorial_required %>
              <% unless is_education? %>
                <li><a href="/site/<%= current_site.username %>">Profile</a></li>
                <li>
                  <a href="/?activity=mine"><span class="float-Left">Activity</span>
                    <% if current_site.unseen_notifications_count > 0 %>
                      <span class="notification-value"><%= current_site.unseen_notifications_count %></span>
                    <% end %>
                  </a>
                </li>
                <li class="divider"></li>
              <% end %>
              <% unless current_site.tutorial_required %>
                <li><a href="/dashboard">Edit</a></li>
              <% end %>
              <li><a href="<%= current_site.uri %>" target="_blank">View</a></li>
              <li><a href="/site/<%= current_site.username %>/stats">Stats</a></li>
              <li class="divider"></li>
            <li><a href="/settings">Settings</a></li>
            <% end %>

            <% if header_account_sites.length > 1 %>
              <li><a href="#siteSwitcher" data-toggle="modal">Switch Site</a></li>
            <% end %>

            <% if current_site.is_admin %>
              <li><a href="/admin">Admin</a></li>
            <% end %>

            <li><a href="#" onclick="$('#signoutForm').submit()">Sign Out</a></li>
            <form id="signoutForm" method="POST" action="/signout" style="display: none">
              <%== csrf_token_input_html %>
            </form>
          </ul>
        </li>

      <% end %>
      <%== erb :'_theme_toggle', layout: false, locals: {icon_only: true} %>
      </ul>
  </nav>

  <div class="logo int-Logo">
    <a href="/" title="back to home">
      <span class="hidden">Neocities.org</span>
      <img src="/img/cat.png" alt="Neocities.org" />
    </a>
  </div>
</header>

<% if header_account_sites.length > 1 %>
  <div class="modal hide fade site-switcher-modal" id="siteSwitcher" tabindex="-1" role="dialog" aria-labelledby="siteSwitcherLabel" aria-describedby="siteSwitcherDescription" aria-hidden="true">
    <div class="modal-header">
      <button class="close" type="button" data-dismiss="modal" aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
      <h3 id="siteSwitcherLabel">Switch Site</h3>
    </div>
    <div class="modal-body">
      <p id="siteSwitcherDescription" class="site-switcher-description">Choose which site you want to use.</p>
      <label class="site-switcher-search-label" for="siteSwitcherSearch">Find a site</label>
      <div class="site-switcher-search">
        <i class="fa fa-search" aria-hidden="true"></i>
        <input id="siteSwitcherSearch" type="search" placeholder="Search by site name" autocomplete="off" aria-controls="siteSwitcherList">
      </div>

      <div class="site-switcher-list" id="siteSwitcherList" role="list">
        <% header_account_sites.each do |site| %>
          <div class="site-switcher-row" data-site-switcher-row data-site-name="<%= site.username.downcase %> <%= site.host.downcase %>" role="listitem"<% if site.id == current_site.id %> aria-current="true"<% end %>>
            <span class="site-switcher-icon" aria-hidden="true"><i class="fa fa-globe"></i></span>
            <div class="site-switcher-copy">
              <strong><%= site.username %></strong>
              <span><%= site.host %></span>
            </div>
            <div class="site-switcher-meta">
              <% if site.parent? %>
                <span class="site-switcher-badge">Parent</span>
              <% end %>
              <% if site.id == current_site.id %>
                <span class="site-switcher-badge site-switcher-current">Current</span>
              <% else %>
                <form action="/settings/<%= site.username %>/switch" method="POST">
                  <%== csrf_token_input_html %>
                  <button class="btn-Action site-switcher-action" type="submit">Switch</button>
                </form>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <p class="site-switcher-empty hide" role="status">No sites match your search.</p>
    </div>
    <div class="modal-footer">
      <a class="site-switcher-manage" href="/settings#sites">Manage sites</a>
      <button class="btn cancel" type="button" data-dismiss="modal">Close</button>
    </div>
  </div>

  <script>
    $(function() {
      var $siteSwitcher = $('#siteSwitcher')
      var $siteSearch = $('#siteSwitcherSearch')
      var $siteRows = $siteSwitcher.find('[data-site-switcher-row]')
      var $siteEmpty = $siteSwitcher.find('.site-switcher-empty')

      function filterSites() {
        var query = $.trim($siteSearch.val()).toLowerCase()
        var visibleSites = 0

        $siteRows.each(function() {
          var matches = $(this).data('site-name').indexOf(query) !== -1
          $(this).toggle(matches)
          if(matches) visibleSites += 1
        })

        $siteEmpty.toggle(visibleSites === 0)
      }

      $siteSearch.on('input', filterSites)
      $siteSwitcher.on('shown', function() { $siteSearch.focus() })
      $siteSwitcher.on('hidden', function() {
        $siteSearch.val('')
        filterSites()
      })
    })
  </script>
<% end %>
